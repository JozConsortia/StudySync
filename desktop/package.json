{
  "name": "studysync-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "StudySync desktop app",
  "main": "main.js",
  "author": "StudySync",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:web": "npm --prefix ../web run build",
    "dist": "npm run build:web && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "build": {
    "appId": "com.studysync.desktop",
    "productName": "StudySync",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
