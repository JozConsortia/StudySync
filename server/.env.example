PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=studysync

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_DAYS=7

# Google Gemini: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional. Defaults to gemini-flash-lite-latest (fast and accurate on the free tier).
GEMINI_MODEL=

# Upload limit in megabytes
MAX_UPLOAD_MB=20
# Seconds to wait for an AI answer before giving up
AI_TIMEOUT_SECONDS=120
