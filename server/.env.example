PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=studysync

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_DAYS=7

# Google Gemini: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional. Defaults to gemini-flash-lite-latest (fast and accurate on the free tier).
GEMINI_MODEL=

# Upload limit in megabytes
MAX_UPLOAD_MB=20
# Seconds to wait for an AI answer before giving up
AI_TIMEOUT_SECONDS=120

# Email for "Forgot password" codes. Without these, codes are printed in the server log instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com and SMTP_PASSWORD=an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
# Outlook / Hotmail: smtp-mail.outlook.com, port 587. Port 465 uses SSL automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: the address emails come from (defaults to SMTP_USER)
SMTP_FROM=

# Text recognition engine is RapidOCR. "auto" reads PDFs that already contain text directly and uses
# RapidOCR for scans and photos (recommended); "rapidocr" runs RapidOCR on every page.
OCR_MODE=auto
